# ── Base de datos ──────────────────────────────────────────────────────────
# Server-only. NUNCA con prefijo NEXT_PUBLIC_.
#
# Supabase (Q-B resuelta). Usa el POOLER, no la conexión directa:
# `db.<ref>.supabase.co` solo resuelve por IPv6, y eso falla tanto en Vercel
# como en muchos portátiles.
#
# Puerto 5432 = "Session mode". NO uses 6543 ("Transaction mode"): ese modo
# multiplexa conexiones por transacción y rompe lo que el sync hace —
# `pg_try_advisory_xact_lock` (el lock AR-6 que evita dos runs concurrentes),
# `CREATE EXTENSION` y las migraciones. Es lo mismo que D15 decidió.
#
#   project ref : zmseqixhtciqylprfh
#   host        : aws-0-us-east-1.pooler.supabase.com
#   port        : 5432   ← Session mode
#   database    : postgres
#   user        : postgres.zmseqixhtciqylprfh
#
# Si tu contraseña tiene caracteres especiales (`@ : / # ?`), percent-encodea.
DATABASE_URL=postgresql://postgres.zmseqixhtciqylprfh:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# La publishable key de Supabase (`sb_publishable_...`) NO va aquí: es para
# clientes de navegador vía PostgREST con RLS. El servidor se conecta por
# Postgres directo. No se usa en este proyecto porque D5 decide que no hay login.
#
# project ref: zmseqixhtciqylprfrfh  →  https://zmseqixhtciqylprfrfh.supabase.co

# región: us-east-1
#
# PITR: actívalo en el panel (Database → Backups). El plan FREE no lo incluye, y
# el corpus curado a mano es irrecuperable si se pierde (AR-14).

# ── Jobs ───────────────────────────────────────────────────────────────────
# Secreto de la auth HMAC de /api/jobs/sync (QStash o runner manual).
# Sin este valor devuelve 503: no hay bypass de desarrollo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_HMAC_SECRET=

# Secreto del cron de Vercel (/api/jobs/cron). Es OTRO secreto, no el mismo:
# el cron no puede firmar un HMAC, solo enviar `Authorization: Bearer …`.
# Sin este valor el cron devuelve 503 y el corpus no se sincroniza.
# Vercel lo inyecta solo si la variable se llama exactamente CRON_SECRET.
CRON_SECRET=

# Cron diario a las 06:00 UTC. El plan Hobby de Vercel solo admite crons
# diarios; una cadencia menor requiere plan Pro.
# vercel.json → crons[].schedule

# ── Alertas ────────────────────────────────────────────────────────────────
# Webhook genérico, no una integración con un proveedor: la misma llamada
# sirve para ntfy, Slack o Discord cambiando la URL.
#
# Recomendado · ntfy (push al móvil, sin cuenta ni API key):
#   1. Abre https://ntfy.sh/beas-alertas-2026 (topic = URL, es el "secreto")
#   2. Instala la app y suscríbete a ese topic
#   ALERT_WEBHOOK_URL=https://ntfy.sh/beas-alertas-2026
#
# Slack:   ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
# Discord: ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/000/XXXX
#
# El cuerpo usa el formato de ntfy (topic/title/message/priority). Para Slack o
# Discord hay que adaptar el JSON: cambiar `renderNotifyBody` en
# src/observability/notify.ts, no el payload del llamante.
#
# Sin URL no hay alertas, pero el sync sigue funcionando: es una dependencia
# opcional a propósito.
ALERT_WEBHOOK_URL=

# Solo si tu canal exige autenticación (los webhooks de Slack/Discord ya la
# traen en la URL; ntfy no la necesita).
ALERT_WEBHOOK_TOKEN=

# ── Observabilidad (opcional en dev) ───────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Entorno ────────────────────────────────────────────────────────────────
NODE_ENV=development